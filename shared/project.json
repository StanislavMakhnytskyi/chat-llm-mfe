{
  "name": "shared",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "shared/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/shared",
        "main": "shared/src/index.ts",
        "tsConfig": "shared/tsconfig.lib.json",
        "assets": []
      }
    }
  }
}
